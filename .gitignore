# >>> media
# Pictures, sound and models live in packs on GitHub releases, not in git (ADR-0090): media.lock names every file,
# scripts/fetch-media.sh installs them, scripts/pack-media.sh packs new ones. scripts/media.py reads this block to
# decide what media is, so keep it between these two markers and keep it first (rules below it still win).
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.ogg
*.wav
*.mp3
*.flac
*.glb
*.gltf
*.vrm
*.fbx
*.blend
*.exr
*.psd
*.mp4
*.webm
# Godot's sidecars travel with their media: with a .import file and no picture, ResourceLoader.exists() is true and
# load() fails, so a fresh clone would log an error for every fallback instead of quietly drawing it.
*.png.import
*.jpg.import
*.jpeg.import
*.webp.import
*.gif.import
*.ogg.import
*.wav.import
*.mp3.import
*.flac.import
*.glb.import
*.gltf.import
*.vrm.import
*.fbx.import
*.blend.import
*.exr.import
# Kept in git all the same: the addons as their authors ship them, and the README's screenshots.
!/game/addons/**
!/docs/images/rootward-*
# <<< media

# Godot
game/.godot/
game/reports/
game/addons/gdUnit4/reports/
*.import.tmp
# Exports
build/
# Python
__pycache__/
.venv/
# The player's list; never committed
WIP.md
# Pipeline caches and heavy intermediates (renders, models, Mixamo takes)
pipeline/cache/
*.blend1
shots/
game/sandbox/runtime/
pipeline/sources/vendor
# Local-only reference skins (third-party models studied for style, never shipped): ADR-0029
game/characters/_local/
pipeline/local/

# Old local music takes (read-only, found through pipeline/music/config.json read_also)
/test/

# Dependencies and builds, for any copy of the project (an evaluation upload too)
node_modules/
venv/
dist/
